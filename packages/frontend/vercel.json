{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace=@noteunix/frontend",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://noteunix-backend.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
