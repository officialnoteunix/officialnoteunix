# ── Server ──────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/noteunix

# ── JWT (generate via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Cloudinary (required — file storage for notes) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (Brevo REST API — works on Render) ────────────────────────
# Sign up: https://app.brevo.com → SMTP & API → API Keys → Generate
# Sender: Senders → Add a sender → verify via email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=officialnoteunix@gmail.com
BREVO_SENDER_NAME=NoteUniX

# ── Backend URL (used for OAuth callback construction) ──
BACKEND_URL=http://localhost:5000

# ── Google OAuth (optional — set these to enable Google sign-in) ──
# Get from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Override callback URL if BACKEND_URL isn't enough (e.g. Render):
# GOOGLE_CALLBACK_URL=https://noteunix-backend.onrender.com/api/auth/google/callback
