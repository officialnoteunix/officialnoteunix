# ── Server ──────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/noteunix

# ── JWT (generate via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Cloudinary (required — file storage for notes) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── SMTP (optional — transactional emails: welcome, contact, notifications) ──
# Use port 465 with SMTP_SECURE=true (required for Render free tier)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@noteunix.com

# ── Google OAuth (optional — set these to enable Google sign-in) ──
# Get from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
